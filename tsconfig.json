{
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "**/*.test.ts", "test/**"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext"
	}
}
