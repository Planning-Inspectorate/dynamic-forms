{
  "name": "@planning-inspectorate/dynamic-forms",
  "version": "0.0.0-semantically-released",
  "description": "This package is for building GDS forms using a configuration-based approach.",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Planning-Inspectorate/dynamic-forms.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && npm run copy-templates",
    "copy-templates": "(cd src && find . -name '*.njk' -exec cp --parents {} ../dist \\;)",
    "commitlint": "commitlint --from=$(git rev-parse $(git cherry origin/main | head -n 1 | cut -c 3-)^1)",
    "lint": "npx eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "prepare": "node .husky/install.mjs",
    "prepack": "npm run build",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "escape-html": "^1.0.3",
    "express-validator": "^7.2.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@planning-inspectorate/coding-standards": "^1.0.0",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/nunjucks": "^3.2.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "body-parser": "^2.2.0",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "globals": "^17.3.0",
    "govuk-frontend": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-prisma": "^5.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.{js,ts,json,md,prisma,yml,yaml,scss}": [
      "prettier --write"
    ]
  }
}
